# Copy this file to backend/.env and change the secrets before real use.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hcm_lite
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
CLIENT_ORIGIN=http://localhost:5173

# Optional first-run admin bootstrap. If these are set on an empty database,
# an Admin user is created automatically. Otherwise use the first-run setup screen.
# COMPANY_NAME=My Company
# ADMIN_NAME=System Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeThisBeforeUse123!

# Optional hosted OpenAI-compatible LLM for flexible AI chat, tool calling,
# Roman Urdu responses and smart-leave date extraction. Never put the key in the frontend.
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4.1-mini
